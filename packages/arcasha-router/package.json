{
  "name": "@arcasha/router",
  "version": "0.1.0",
  "description": "Observation-Driven Adaptive Routing (ODAR) — belief-driven routing engine for heterogeneous LLM pools. Standalone core of ArcAsha (Belief-Driven AI Orchestration). Pure TypeScript, no runtime deps, works in Node/WebGPU/edge.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "clean": "rm -rf dist",
    "test": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "routing",
    "bandit",
    "linucb",
    "llm",
    "orchestration",
    "arcasha",
    "belief",
    "contextual-bandit",
    "heterogeneous"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
