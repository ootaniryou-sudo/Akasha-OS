{
  "name": "arcasha",
  "version": "0.1.0",
  "description": "ArcAsha — Belief-Driven AI Orchestration meta package. Bundles arcasha-core / arcasha-belief / arcasha-router / arcasha-orchestrator into a single import.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "arcasha-belief": "0.1.0",
    "arcasha-core": "0.1.0",
    "arcasha-orchestrator": "0.1.0",
    "arcasha-router": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "arcasha",
    "orchestration",
    "routing",
    "llm",
    "belief",
    "odar",
    "bayesian"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ootaniryou-sudo/ArcAsha-os.git"
  },
  "homepage": "https://github.com/ootaniryou-sudo/ArcAsha-os",
  "bugs": {
    "url": "https://github.com/ootaniryou-sudo/ArcAsha-os/issues"
  }
}
