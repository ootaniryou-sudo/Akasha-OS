{
  "name": "@arcasha/core",
  "version": "0.1.0",
  "description": "ArcAsha core — shared types, rule-based observation (quality) and multi-objective reward (Quality + Latency + Cost + Stability).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "arcasha",
    "routing",
    "reward",
    "observation"
  ],
  "license": "MIT"
}
