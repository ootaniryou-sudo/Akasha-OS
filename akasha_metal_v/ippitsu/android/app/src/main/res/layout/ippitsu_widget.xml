<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- ヘッダー -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="一筆"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E" />

        <TextView
            android:id="@+id/memo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#8E8E93"
            tools:text="3件" />
    </LinearLayout>

    <!-- メモアイテム 1 -->
    <LinearLayout
        android:id="@+id/memo_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="ミーティングの資料を作成する" />
    </LinearLayout>

    <!-- メモアイテム 2 -->
    <LinearLayout
        android:id="@+id/memo_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="牛乳を買う" />
    </LinearLayout>

    <!-- メモアイテム 3 -->
    <LinearLayout
        android:id="@+id/memo_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="来週の旅行の計画を立てる" />
    </LinearLayout>

    <!-- メモアイテム 4 -->
    <LinearLayout
        android:id="@+id/memo_item_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="誕生日プレゼントを買う" />
    </LinearLayout>

    <!-- メモアイテム 5 -->
    <LinearLayout
        android:id="@+id/memo_item_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_5"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="病院の予約をする" />
    </LinearLayout>

    <!-- メモアイテム 6 -->
    <LinearLayout
        android:id="@+id/memo_item_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_6"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="読書: デザインパターンの勉強" />
    </LinearLayout>

    <!-- メモアイテム 7 -->
    <LinearLayout
        android:id="@+id/memo_item_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_7"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="新しいアイデアを書き留める" />
    </LinearLayout>

    <!-- メモアイテム 8 -->
    <LinearLayout
        android:id="@+id/memo_item_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/priority_dot_8"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/priority_dot_normal" />

        <TextView
            android:id="@+id/memo_text_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#1C1C1E"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="週末の予定を確認する" />
    </LinearLayout>

</LinearLayout>
